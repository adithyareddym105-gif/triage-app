# --- LLM (Gemini through its OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key
LLM_MODEL=gemini-2.5-flash
# Prices in USD per 1M tokens (used for the cost column; Gemini free tier is actually $0)
LLM_PRICE_IN_PER_M=0.30
LLM_PRICE_OUT_PER_M=2.50

# --- Decision model (vLLM Semantic Router, Decision 3.0, free API) ---
# Get a free key in one click at https://decision.vllm-sr.ai (home page, "Get API key")
DM_BASE_URL=https://decision.vllm-sr.ai
DM_API_KEY=sk-vsr-your-key
DM_MODEL=vllm-sr/d3-turbo
DM_PRICE_IN_PER_M=0
# dm+llm: below this confidence the LLM takes over the classification
DM_CONFIDENCE_THRESHOLD=0.7
